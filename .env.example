# =============================================================================
# cocarr-core-api — environment variables
# Copy to .env for local dev; set these in the Railway service for production.
# Values shown are placeholders/defaults — never commit real secrets.
# Extracted from the codebase (process.env references). Grouped by concern.
# =============================================================================

# --- Runtime -----------------------------------------------------------------
NODE_ENV=production
PORT=3030                                  # Railway injects PORT; app falls back to 3030

# --- Database (MySQL, Sequelize) ---------------------------------------------
DB_HOST=your-mysql-host
DB_PORT=3306
DB_NAME=cocarr_core
DB_USER=cocarr
DB_PASS=change-me

# --- Public API base (used to build proxied image URLs) ----------------------
PUBLIC_API_URL=https://api.cocarr.com/v1

# --- Firebase (two SEPARATE projects) ----------------------------------------
# Provide the service-account JSON as a single-line string (or a path your
# helper reads). USER project = riders/hosts; ADMIN project = panel staff.
USER_SERVICE_ACCOUNT=
ADMIN_SERVICE_ACCOUNT=

# --- Admin bootstrap (break-glass super admin — keeps panel administrable) ---
BOOTSTRAP_SUPER_ADMIN_EMAIL=cocarrluxury23@gmail.com
BOOTSTRAP_SUPER_ADMIN_PASSWORD=
BOOTSTRAP_REISSUE_RESET_LINK=false

# --- RBAC / panel binding ----------------------------------------------------
RBAC_ENFORCE=true                          # set 'false' for dry-run (logs denials, allows)
SEED_DEFAULTS=false                        # seed default teams/permissions on boot
ADMIN_PANEL_URL=https://admin.cocarr.com
# Comma-separated panel=origin / panel=key / team=home maps (see CLAUDE.md):
ADMIN_PANEL_ORIGINS=root=https://root.cocarr.com,admin=https://admin.cocarr.com
ADMIN_PANEL_KEYS=                          # optional stronger check: root=<secret>,admin=<secret>
ADMIN_PANEL_HOMES=                         # cutover switch, e.g. operations=ops

# --- CORS --------------------------------------------------------------------
# Comma-separated allowlist of browser origins (admin panels AND rider web app).
# Unset = allow all with a loud warning.
CORS_ORIGINS=https://admin.cocarr.com,https://cocarr.com

# --- Object storage (S3-compatible: Tigris). Aliases accepted. --------------
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
S3_ENDPOINT=https://t3.storageapi.dev
S3_REGION=auto
# (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_BUCKET / AWS_REGION /
#  AWS_ENDPOINT_URL_S3 and S3_* equivalents are all recognised too.)

# --- Payments (Razorpay) — NOTE the unintuitive names ------------------------
PG_KEY=                                    # Razorpay key id
PG_SEC=                                    # Razorpay key secret (also verifies payment signatures)
PG_HIDDEN=                                 # Razorpay WEBHOOK secret (separate from PG_SEC)

# --- KYC (Cashfree / provider) ----------------------------------------------
KYC_BASE=
KYC_URL=
KYC_ID=
KYC_SECRET=
KYC_API_VERSION=
KYC_PROXY_URL=
KYC_RC_OCR=
KYC_RC_VERIFICATION=
KYC_LICENCE_VERIFY=
# Signature verification public key: defaults to the committed
# accountId_61985_public_key.pem. Override with a path or inline PEM if needed.
KYC_PUBLIC_KEY_PATH=accountId_61985_public_key.pem
KYC_PUBLIC_KEY=

# --- Email / SMS -------------------------------------------------------------
SENDGRID_API_KEY=
MSG_KEY=                                   # MSG91 auth key
MSG91_CAMPAIGN_FLOW_ID=
GOOGLE_API_KEY=                            # Google APIs (maps/geocode)

# --- Scheduled jobs (node-cron) ----------------------------------------------
# NOTE: crons run in-process. Enable on exactly ONE instance if you scale out.
SETTLEMENT_CRON_ENABLED=true
SETTLEMENT_CRON=
SETTLEMENT_TIMEZONE=Asia/Kolkata
REFUND_CRON_ENABLED=true
REFUND_CRON=
REFUND_TIMEZONE=Asia/Kolkata
REFUND_HOLD_DAYS=
DAMAGE_REPORT_WINDOW_HOURS=
LATE_RETURN_GRACE_HOURS=
